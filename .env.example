# ── Enterprise NeXus — Docker host ports ──────────────────────
# Copy to .env (project root). Docker Compose reads this file
# automatically. Change these when another project already uses
# the default ports, so many projects can run side by side.

NEXUS_FRONTEND_PORT=3000
NEXUS_BACKEND_PORT=5000
NEXUS_N8N_PORT=5678

# Example for a second machine-wide slot:
# NEXUS_FRONTEND_PORT=3100
# NEXUS_BACKEND_PORT=5100
# NEXUS_N8N_PORT=5778
