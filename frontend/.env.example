# ── Enterprise NeXus — Frontend environment ───────────────────
# Copy this file to .env.local and adjust if needed.
# All values below work out of the box for local development.

# Backend API base URL (the /api suffix is required)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Production on Vercel uses NEXT_PUBLIC_API_URL=/api and routes that path to
# Render through next.config.js. Set this only in Vercel; keep the localhost
# value above for local development.
# BACKEND_API_ORIGIN=https://enterprise-nexus-backend.onrender.com

# ── Supabase Realtime (OPTIONAL) ──────────────────────────────
# Enables live dashboard refresh. If left as-is, the app silently
# falls back to polling — everything still works.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Sentry error reporting (OPTIONAL) ─────────────────────────
# Leave blank to disable.
NEXT_PUBLIC_SENTRY_DSN=
